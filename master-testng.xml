<suite name = "TestSuite" parallel = "tests" thread-count = "2">
    <listeners>
        <listener class-name="org.testng.reporters.XMLReporter"/>
        <listener class-name="org.testng.reporters.EmailableReporter2"/>
        <listener class-name="utils.FrameworkListener" />
        <!-- <listener class-name="com.example.MyMethodInterceptor" /> -->
    </listeners>

    <!-- Suite-level defaults: provide a browser so @Parameters('browser') is satisfied when not set per-test -->
    <parameter name="browser" value="chrome"/>

    <test name = "LoginTestsWithoutParameters">
        <classes>
            <class name = "tests.LoginTests"/>
        </classes>
    </test>

    <test name = "LoginTestsWithParameters">
        <parameter name="username" value="Admin"/>
        <parameter name="password" value="admin123"/>
        <classes>
            <class name = "tests.LoginTests"/>
        </classes>
    </test>
</suite>